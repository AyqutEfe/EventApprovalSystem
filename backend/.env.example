# ==========================================
# KYCUBYO Event Approval System - Ortam Değişkenleri
# ==========================================
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env dosyası asla Git'e gönderilmemelidir!

# Veritabanı
DB_HOST=YOURHOST
DB_PORT=YOUR_PORT
DB_NAME={YOUR_DB_NAME}
DB_USERNAME={YOUR_USERNAME}
DB_PASSWORD={YOUR_PASSWORD}

# JWT
JWT_SECRET={YOUR_SECRET}
JWT_EXPIRATION={YOUR_EXPIRATION}

# Sunucu
SERVER_PORT={YOUR_PORT}

# Belge Çıktı Dizini
DOCUMENT_OUTPUT_DIR={YOUR_DOCUMENT_OUTPUT_DIR}
